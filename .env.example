# ===========================
# SEAM Environment Variables
# ===========================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ----- Application -----
APP_NAME=SEAM
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ----- Backend (FastAPI) -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
CORS_ORIGINS=http://localhost:5173

# ----- Frontend (Vite) -----
VITE_API_BASE_URL=http://localhost:8000/api

# ----- Ollama -----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_CODING=deepseek-coder
OLLAMA_MODEL_GENERAL=llama3.1
OLLAMA_TIMEOUT=120

# ----- ChromaDB -----
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=seam_knowledge

# ----- RAG Configuration -----
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# ----- Knowledge Repository -----
KNOWLEDGE_BASE_DIR=./knowledge/data
KNOWLEDGE_VALIDATED_DIR=./knowledge/validated

# ----- Git/GitHub -----
GITHUB_TOKEN=
GITHUB_REPO=

# ----- Docker -----
DOCKER_REGISTRY=
DOCKER_IMAGE_TAG=latest

# ----- Security -----
SECRET_KEY=change-me-in-production
API_KEY=
